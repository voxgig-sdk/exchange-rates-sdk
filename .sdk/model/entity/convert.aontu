# Entity: convert

main: kit: entity: convert: {

  alias: field: {}

  fields: {
    date: {
      h: "Date"
      n: "date"
      r: true
      t: "`$STRING`"
    }
    free: {
      h: "Free"
      n: "free"
      r: false
      sh: "Indicates if this was a free (unauthenticated) request"
      t: "`$BOOLEAN`"
    }
    info: {
      h: "Info"
      n: "info"
      r: true
      t: "`$OBJECT`"
    }
    query: {
      h: "Query"
      n: "query"
      r: true
      t: "`$OBJECT`"
    }
    result: {
      h: "Result"
      n: "result"
      r: true
      sh: "Conversion result"
      t: "`$NUMBER`"
    }
    success: {
      h: "Success"
      n: "success"
      r: true
      t: "`$BOOLEAN`"
    }
  }

  name: "convert"
  op: {
    load: {
      name: "load"
      points: [
        {
          co: {
            id: "GET /convert"
            source: "openapi3"
            version: 2
          }
          g: {
            query: [
              {
                ex: 100
                k: "query"
                n: "amount"
                or: "amount"
                r: true
                t: "`$NUMBER`"
              }
              {
                ex: "2025-08-31"
                k: "query"
                n: "date"
                or: "date"
                r: false
                t: "`$STRING`"
              }
              {
                ex: "AUD"
                k: "query"
                n: "from"
                or: "from"
                r: true
                t: "`$STRING`"
              }
              {
                ex: "USD"
                k: "query"
                n: "to"
                or: "to"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/convert"
          q: {
            exist: [
              "amount"
              "date"
              "from"
              "to"
            ]
          }
          s: [
            {
              lit: "convert"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
