# Entity: get_historical_rate_for_currency_and_date

main: kit: entity: get_historical_rate_for_currency_and_date: {

  alias: field: {}

  fields: [
    {
      name: "base"
      req: false
      type: "`$STRING`"
    }
    {
      name: "date"
      req: false
      type: "`$STRING`"
    }
    {
      name: "id"
      req: false
      type: "`$STRING`"
    }
    {
      name: "rates"
      req: false
      type: "`$OBJECT`"
    }
    {
      name: "success"
      req: false
      type: "`$BOOLEAN`"
    }
    {
      name: "timestamp"
      req: false
      type: "`$INTEGER`"
    }
  ]

  id: {
    field: "id"
    from: {
      date: "date"
    }
    name: "id"
    parts: [
      "date"
      "currency"
    ]
    sep: "/"
  }

  name: "get_historical_rate_for_currency_and_date"
  op: {
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                example: "USD"
                kind: "param"
                name: "currency"
                orig: "currency"
                reqd: true
                type: "`$STRING`"
              }
              {
                example: "2025-08-31"
                kind: "param"
                name: "date"
                orig: "date"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/{date}/{currency}"
          segments: [
            {
              var: "date"
            }
            {
              var: "currency"
            }
          ]
          select: {
            exist: [
              "currency"
              "date"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body.rates`"
          }
        }
      ]
    }
  }



}
