# Entity: latest

main: kit: entity: latest: {

  alias: field: {}

  fields: {
    base: {
      h: "Base"
      n: "base"
      r: false
      t: "`$STRING`"
    }
    date: {
      h: "Date"
      n: "date"
      r: false
      t: "`$STRING`"
    }
    id: {
      h: "Id"
      n: "id"
      r: false
      t: "`$STRING`"
    }
    rates: {
      h: "Rates"
      n: "rates"
      r: false
      t: "`$OBJECT`"
    }
    success: {
      h: "Success"
      n: "success"
      r: false
      t: "`$BOOLEAN`"
    }
    timestamp: {
      h: "Timestamp"
      n: "timestamp"
      r: false
      t: "`$INTEGER`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "latest"
  op: {
    load: {
      name: "load"
      points: [
        {
          co: {
            id: "GET /latest"
            source: "openapi3"
            version: 2
          }
          g: {
            query: [
              {
                ex: "AUD"
                k: "query"
                n: "base"
                or: "base"
                r: false
                t: "`$STRING`"
              }
              {
                ex: "USD,EUR,GBP"
                k: "query"
                n: "symbol"
                or: "symbol"
                r: false
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/latest"
          q: {
            exist: [
              "base"
              "symbol"
            ]
          }
          s: [
            {
              lit: "latest"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body.rates`"
          }
        }
        {
          co: {
            id: "GET /latest/{currency}"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                ex: "USD"
                k: "param"
                n: "id"
                or: "currency"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/latest/{currency}"
          q: {
            exist: [
              "id"
            ]
          }
          r: {
            param: {
              currency: "id"
            }
          }
          s: [
            {
              lit: "latest"
            }
            {
              var: "id"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body.rates`"
          }
        }
      ]
    }
  }



}
