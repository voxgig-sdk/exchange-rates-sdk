# BasicLatestFlow

main: kit: flow: BasicLatestFlow:
{
  entity: "latest",
  kind: "basic",
  name: "BasicLatestFlow",
  step: [
    {
      i: {
        ref: "latest_ref01",
        srcdatavar: "latest_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "latest01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-latest_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicLatestFlow"
}